# 複製成 backend/.env 後依環境修改：cp .env.example .env

PORT=3000

# PostgreSQL。使用 docker compose 時維持預設即可；
# 使用本機安裝的 PostgreSQL 時改成自己的帳號、密碼與資料庫名稱。
DATABASE_URL=postgres://diary:diary@localhost:5432/diary

# 雲端資料庫（Supabase）需要 TLS：設為 true 會加密連線但不驗證憑證；
# 要驗證伺服器身分，改把 Supabase 的根憑證（PEM）貼到 DATABASE_CA_CERT。
DATABASE_SSL=false
# DATABASE_CA_CERT=

# MongoDB（公開搜尋與瀏覽事件）。留空則不記錄事件，其餘功能照常運作。
MONGO_URL=mongodb://localhost:27017
MONGO_DB=diary_events

# 登入 cookie 的簽章密鑰：正式環境務必換成隨機長字串
JWT_SECRET=change-me-to-a-long-random-string

# 以 HTTPS 提供服務時設為 true，cookie 會加上 Secure
COOKIE_SECURE=false

# 照片儲存資料夾（相對於 backend/），本機開發使用
UPLOAD_DIR=uploads

# 設定下面兩項後，照片改存 Supabase Storage 的私有 bucket（部署到 Vercel 時必填）。
# SUPABASE_SERVICE_KEY 是 secret／service_role 金鑰，只能放在後端，不可提交到 Git。
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=diary-photos
