# 複製成 backend/.env 後依環境修改：cp .env.example .env

PORT=3000

# PostgreSQL。使用 docker compose 時維持預設即可；
# 使用本機安裝的 PostgreSQL 時改成自己的帳號、密碼與資料庫名稱。
DATABASE_URL=postgres://diary:diary@localhost:5432/diary

# MongoDB（公開搜尋與瀏覽事件）。留空則不記錄事件，其餘功能照常運作。
MONGO_URL=mongodb://localhost:27017
MONGO_DB=diary_events

# 登入 cookie 的簽章密鑰：正式環境務必換成隨機長字串
JWT_SECRET=change-me-to-a-long-random-string

# 以 HTTPS 提供服務時設為 true，cookie 會加上 Secure
COOKIE_SECURE=false

# 照片儲存資料夾（相對於 backend/）
UPLOAD_DIR=uploads
